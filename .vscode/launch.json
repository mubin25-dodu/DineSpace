{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Visual Studio NestJS Debugger",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": ["start", "--debug", "--watch"],
      "console": "integratedTerminal",
      "restart": false,
      "sourceMaps": true,
      "autoAttachChildProcesses": true
    }
  ]
}
